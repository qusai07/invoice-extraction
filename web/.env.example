# Copy to .env.local

# The .NET API (server-side proxy target; never exposed to the browser).
API_BASE_URL=http://localhost:5080

# "session" (default): InvoiceFlow sign-in with email + password (API Auth:Mode=Session).
# "dev": pick a demo user without a password (API must run with Auth:Mode=Dev).
NEXT_PUBLIC_AUTH_MODE=session
